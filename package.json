{
  "name": "labelpress",
  "productName": "标印 LabelPress",
  "version": "1.1.0",
  "description": "商品信息管理 + 条形码生成 + 标签打印（免安装便携版）",
  "main": "main.js",
  "author": "LabelPress",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.labelpress.app",
    "productName": "标印 LabelPress",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "标印LabelPress-便携版-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3"
  }
}
